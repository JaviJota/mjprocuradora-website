---
interface Props {
  class?: string;
}
const { class: className = "text-brand-brass-deep" } = Astro.props;
---

<svg aria-hidden="true" focusable="false" height="16" width="16" viewBox="0 0 16 16" fill="none" class:list={["shrink-0", className]}>
  <path
    d="M8 14.5s5-4.3 5-8.25a5 5 0 1 0-10 0C3 10.2 8 14.5 8 14.5Z"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <circle cx="8" cy="6.25" r="1.75" stroke="currentColor" stroke-width="1.5"></circle>
</svg>
