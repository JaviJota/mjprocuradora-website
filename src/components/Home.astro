---
import Intro from "../assets/intro.md";
import { Image } from "astro:assets";
import portrait from "../assets/Maria-Jose-Carralero-Medina.webp";
import hero from "../assets/fotos/palacio-justicia-columnas.jpg";
import Button from "./Button.astro";

const credentials = [
  "Decana del Ilustre Colegio de Procuradores de Córdoba",
  "Vicepresidenta del Consejo Andaluz de Procuradores",
  "Licenciada en Derecho y diplomada en Criminología",
  "Profesora del Máster de Abogacía y Procura",
];
---

<section
  class="relative isolate flex min-h-[100svh] items-center overflow-hidden pb-24 pt-32"
  aria-labelledby="hero-title"
>
  <Image
    src={hero}
    alt=""
    widths={[768, 1280, 1920, 2880]}
    sizes="100vw"
    quality={80}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <!-- Degradados: atenúan la foto, dan contraste al texto y la funden con el fondo de la página -->
  <div class="absolute inset-0 -z-10 bg-brand-navy/70" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgb(30_42_51/0.55),transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-brand-ink/80 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-brand-navy to-transparent" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <h1 id="hero-title" class="text-balance">
      <span class="block text-sm font-semibold uppercase tracking-[0.25em] text-brand-gold">
        Procuradora en Córdoba
      </span>
      <span class="mt-5 block text-4xl font-extrabold leading-tight text-white sm:text-6xl">
        Tu respaldo legal en cada paso del camino.
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-pretty text-lg text-white/85">
      Representación procesal y gestión de procedimientos judiciales en Córdoba y Andalucía, con trato directo y
      seguimiento continuo de cada asunto.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <Button href="/contacto">Solicita una consulta</Button>
      <Button href="/areas-de-trabajo" variant="secondary">Áreas de trabajo</Button>
    </div>
  </div>

  <a
    href="#sobre-mi"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-sm text-white/70 transition-colors hover:text-white"
  >
    Conoce a María José
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</section>

<section class="mx-auto max-w-6xl scroll-mt-8 px-4 py-20 sm:px-6 lg:px-8" aria-labelledby="sobre-mi">
  <div class="grid items-start gap-12 lg:grid-cols-[1fr_auto] lg:gap-16">
    <div>
      <h2 id="sobre-mi" class="text-3xl font-semibold text-white">María José Carralero Medina</h2>
      <div class="mt-6 h-px w-16 bg-brand-gold" aria-hidden="true"></div>
      <div class="prose prose-invert prose-lg mt-8 max-w-none prose-p:text-white/85">
        <Intro />
      </div>
    </div>

    <figure class="mx-auto w-full max-w-sm lg:sticky lg:top-8">
      <Image
        src={portrait}
        alt="Retrato de María José Carralero Medina, procuradora en Córdoba"
        widths={[384, 768]}
        sizes="(min-width: 1024px) 384px, 90vw"
        class="aspect-[3/4] w-full rounded-md object-cover shadow-2xl ring-1 ring-white/10"
      />
      <figcaption class="mt-6">
        <ul class="space-y-3">
          {credentials.map((item) => (
            <li class="flex gap-3 text-white/85">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-gold" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </figcaption>
    </figure>
  </div>
</section>
