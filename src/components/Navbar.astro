---
import Menu from "../icons/Menu.astro"
import { Image } from "astro:assets"
import img from "../assets/mj-logo-blanco-02.svg"

const links = [
  { href: "/", label: "Inicio" },
  { href: "/areas-de-trabajo", label: "Áreas de trabajo" },
  // { href: "/recursos", label: "Recursos" },
  { href: "/contacto", label: "Contacto" },
];

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["z-20", overlay ? "absolute inset-x-0 top-0" : "relative"]}>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="shrink-0">
      <Image
        src={img}
        alt="María José Carralero Medina, procuradora · Inicio"
        class="h-16 w-auto lg:h-20"
        loading="eager"
      />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={current === href ? "page" : undefined}
              class="nav-link text-lg font-semibold text-white"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-md md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu />
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Principal"
    data-open="false"
    class="mobile-menu absolute inset-x-0 top-full border-y border-white/10 bg-brand-ink shadow-xl md:hidden"
  >
    <ul class="flex flex-col px-4 py-2">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={current === href ? "page" : undefined}
            class="block py-3 text-lg font-semibold text-white aria-[current=page]:text-brand-gold"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    };

    toggle.addEventListener("click", () => setOpen(menu.dataset.open !== "true"));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.dataset.open === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* Subrayado dorado: no desplaza el layout (antes border-b-2 + scale movían el texto) */
  .nav-link {
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    text-decoration-color: transparent;
    transition: text-decoration-color 150ms ease;
  }
  .nav-link:hover {
    text-decoration-color: rgb(255 255 255 / 0.5);
  }
  .nav-link[aria-current="page"] {
    text-decoration-color: #bfa76a;
  }

  /* visibility evita que los enlaces ocultos reciban foco con el teclado */
  .mobile-menu {
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1),
      visibility 0s linear 200ms;
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }
</style>
