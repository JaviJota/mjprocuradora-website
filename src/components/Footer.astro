---
import { Image } from "astro:assets"
import logo from "../assets/mj-logo-blanco-02.svg"
import Mail from "../icons/Mail.astro"
import Phone from "../icons/Phone.astro"
import MapPin from "../icons/MapPin.astro"

const currentYear = new Date().getFullYear()
const link = "text-brand-cream/75 underline-offset-4 transition-colors hover:text-brand-cream hover:underline"
const heading = "text-sm font-semibold uppercase tracking-[0.18em] text-brand-brass"
---

<footer class="on-dark mt-24 bg-brand-ink text-brand-cream">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_1.5fr_0.9fr] lg:px-8">
        <div>
            <Image src={logo} alt="María José Carralero Medina, procuradora" class="h-14 w-auto" />
            <p class="mt-6 max-w-xs text-brand-cream/75">
                Procuradora de los Tribunales, colegiada nº 367 del Ilustre Colegio de Procuradores de Córdoba. Representación procesal con trato directo y seguimiento continuo.
            </p>
        </div>

        <nav aria-label="Secundaria">
            <p class={heading}>Navegación</p>
            <ul class="mt-5 space-y-3">
                <li><a class={link} href="/">Inicio</a></li>
                <li><a class={link} href="/areas-de-trabajo">Áreas de trabajo</a></li>
                <li><a class={link} href="/contacto">Contacto</a></li>
            </ul>
        </nav>

        <address class="not-italic">
            <p class={heading}>Contacto</p>
            <ul class="mt-5 space-y-3">
                <li class="flex items-center gap-3">
                    <Phone class="text-brand-brass" />
                    <a class={link} href="tel:+34687775744">+34 687 775 744</a>
                </li>
                <li class="flex items-center gap-3">
                    <Mail class="text-brand-brass" />
                    <a class:list={[link, "break-all sm:break-normal"]} href="mailto:mjcarralero@cordoba.cgpe.net">mjcarralero@cordoba.cgpe.net</a>
                </li>
                <li class="flex items-start gap-3 text-brand-cream/75">
                    <MapPin class="mt-1 text-brand-brass" />
                    Córdoba, Sevilla, Málaga, Jaén y Granada
                </li>
            </ul>
        </address>

        <nav aria-label="Información legal">
            <p class={heading}>Legal</p>
            <ul class="mt-5 space-y-3">
                <li><a class={link} href="/aviso-legal">Aviso legal</a></li>
                <li><a class={link} href="/politica-de-privacidad">Política de privacidad</a></li>
            </ul>
        </nav>
    </div>

    <div class="border-t border-white/10">
        <p class="mx-auto max-w-6xl px-4 py-6 text-sm text-brand-cream/70 sm:px-6 lg:px-8">
            © {currentYear} María José Carralero Medina. Todos los derechos reservados.
        </p>
    </div>
</footer>
