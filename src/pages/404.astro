---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout title="Página no encontrada · María José Carralero Medina" noindex>
  <div class="grid place-items-center px-6 py-24 text-center sm:py-32">
    <p class="font-serif text-8xl italic text-brand-brass-deep">404</p>
    <h1 class="mt-4 text-balance font-serif text-5xl tracking-tight text-brand-ink sm:text-6xl">Página no encontrada</h1>
    <p class="mt-6 text-pretty text-lg text-brand-muted">Lo sentimos, no pudimos encontrar la página que buscas.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <Button href="/">Ir al inicio</Button>
      <Button href="/contacto" variant="secondary">Contacto</Button>
    </div>
  </div>
</Layout>
