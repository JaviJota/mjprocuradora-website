---
import Mail from "../icons/Mail.astro";
import Phone from "../icons/Phone.astro";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

const input =
  "mt-2 block w-full rounded-md border-0 bg-white px-3 py-2.5 text-brand-ink shadow-sm " +
  "placeholder:text-slate-400 focus-visible:outline-brand-gold";
const label = "block text-sm font-medium text-white";
---

<Layout
  title="Contacto · Procuradora en Córdoba · María José Carralero Medina"
  description="Contacta con María José Carralero Medina, procuradora en Córdoba. Teléfono +34 687 775 744, correo electrónico o formulario de contacto."
>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-gold">Hablemos de tu caso</p>
      <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">Contacto</h1>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
      <section aria-labelledby="datos">
        <h2 id="datos" class="text-2xl font-semibold text-white">Datos de contacto</h2>
        <address class="mt-6 not-italic">
          <ul class="space-y-4">
            <li class="flex items-center gap-3">
              <Mail />
              <a
                class="break-all text-white underline decoration-white/30 underline-offset-4 hover:decoration-brand-gold"
                href="mailto:mjcarralero@cordoba.cgpe.net">mjcarralero@cordoba.cgpe.net</a
              >
            </li>
            <li class="flex items-center gap-3">
              <Phone />
              <a
                class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-brand-gold"
                href="tel:+34687775744">+34 687 775 744</a
              >
            </li>
          </ul>
        </address>
      </section>

      <section aria-labelledby="formulario" class="rounded-md border border-white/10 bg-white/[0.06] p-6 sm:p-8">
        <h2 id="formulario" class="text-2xl font-semibold text-white">Formulario de contacto</h2>
        <p class="mt-2 text-sm text-white/75">Todos los campos son obligatorios.</p>

        <form id="contact-form" class="mt-8 space-y-6" novalidate>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class={label} for="nombre">Nombre</label>
              <input class={input} type="text" name="nombre" id="nombre" autocomplete="given-name" required />
            </div>
            <div>
              <label class={label} for="apellido">Apellidos</label>
              <input class={input} type="text" name="apellido" id="apellido" autocomplete="family-name" required />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class={label} for="email">Correo electrónico</label>
              <input class={input} type="email" name="email" id="email" autocomplete="email" required />
            </div>
            <div>
              <label class={label} for="telefono">Teléfono</label>
              <input
                class={input}
                type="tel"
                name="teléfono"
                id="telefono"
                autocomplete="tel"
                inputmode="tel"
                minlength="9"
                required
              />
            </div>
          </div>

          <div>
            <label class={label} for="descripcion">¿En qué puedo ayudarte?</label>
            <textarea class:list={[input, "min-h-36"]} name="descripción" id="descripcion" rows="5" required></textarea>
          </div>

          <div class="flex gap-3">
            <input
              class="mt-1 h-5 w-5 shrink-0 accent-brand-gold"
              type="checkbox"
              id="privacidad"
              name="privacidad"
              required
            />
            <label for="privacidad" class="text-sm text-white/85">
              He leído y acepto la <a
                href="/politica-de-privacidad"
                class="text-white underline underline-offset-4 hover:text-brand-gold">política de privacidad</a
              >.
            </label>
          </div>

          <p id="form-status" role="status" aria-live="polite" class="min-h-6 text-sm font-medium"></p>

          <Button type="submit" class="w-full sm:w-auto">Enviar mensaje</Button>
        </form>
      </section>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  const setStatus = (message: string, type: "ok" | "error" | "") => {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle("text-emerald-300", type === "ok");
    status.classList.toggle("text-red-300", type === "error");
  };

  if (form) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea"));
      fields.forEach((field) => field.setAttribute("aria-invalid", String(!field.checkValidity())));

      const firstInvalid = fields.find((field) => !field.checkValidity());
      if (firstInvalid) {
        setStatus("Revisa los campos marcados: todos son obligatorios.", "error");
        firstInvalid.focus();
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (submit) submit.disabled = true;
      setStatus("Enviando…", "");

      try {
        const response = await fetch("/api/contact", { method: "POST", body: new FormData(form) });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          setStatus(result.error ?? "No se pudo enviar el mensaje. Inténtalo de nuevo o llama por teléfono.", "error");
          return;
        }

        form.reset();
        fields.forEach((field) => field.removeAttribute("aria-invalid"));
        setStatus("¡Mensaje enviado! Te responderé a la mayor brevedad.", "ok");
      } catch {
        setStatus("No se pudo enviar el mensaje. Comprueba tu conexión o llama por teléfono.", "error");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style>
  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    box-shadow: 0 0 0 2px #fca5a5;
  }
</style>
